generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  /// 화면 설정 (목록 정렬 기준 등). 형식은 src/lib/prefs.ts
  prefs        Json?
  /// 자동 배당을 마지막으로 맞춘 시각 (하루 한 번, 기록이 바뀌면 비운다)
  dividendsSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  accounts     Account[]
}

/// 증권 계좌 (예: "키움 일반", "미래에셋 ISA")
model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  broker       String?
  memo         String?
  /// 계좌 종류: 배당 원천징수를 정한다 (일반: 국내 15.4%·미국 15%, ISA·연금: 국내 배당은 받을 때 떼지 않음)
  kind         AccountKind   @default(GENERAL)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  dividends    Dividend[]
  cashFlows    CashFlow[]
  dividendSkips DividendSkip[]

  @@index([userId])
}

enum AccountKind {
  GENERAL
  ISA
  PENSION
}

enum Market {
  KOSPI
  KOSDAQ
  US
}

enum TradeType {
  BUY
  SELL
}

/// 매수/매도 기록. 가격은 종목의 현지 통화(KRW 또는 USD) 기준.
model Transaction {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Yahoo 형식 심볼 (005930.KS, 035720.KQ, AAPL)
  symbol    String
  name      String
  market    Market
  type      TradeType
  quantity  Decimal   @db.Decimal(20, 6)
  price     Decimal   @db.Decimal(20, 4)
  fee       Decimal   @default(0) @db.Decimal(20, 4)
  tax       Decimal   @default(0) @db.Decimal(20, 4)
  /// 거래 시점 환율 (1 USD 당 KRW). KRW 종목은 1.
  fxRate    Decimal   @default(1) @db.Decimal(20, 4)
  tradeDate DateTime  @db.Date
  memo      String?
  createdAt DateTime  @default(now())

  @@index([accountId, tradeDate])
}

/// 배당금 입금 기록. 금액은 종목의 현지 통화(KRW 또는 USD) 기준.
model Dividend {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  market    Market
  /// 세전 배당금 합계
  amount    Decimal  @db.Decimal(20, 4)
  /// 원천징수 세금
  tax       Decimal  @default(0) @db.Decimal(20, 4)
  /// 지급일 환율 (1 USD 당 KRW). KRW 종목은 1.
  fxRate    Decimal  @default(1) @db.Decimal(20, 4)
  payDate   DateTime @db.Date
  memo      String?
  /// 배당 이력과 보유 수량으로 앱이 자동으로 만든 기록 (사용자가 고치면 false가 되어 다시 덮어쓰지 않는다)
  auto      Boolean  @default(false)
  /// 배당락일 (자동 기록만)
  exDate    DateTime? @db.Date
  createdAt DateTime @default(now())

  @@index([accountId, payDate])
  /// 자동 배당은 계좌·종목·배당락일마다 하나 (수동 기록은 exDate가 비어 있어 걸리지 않는다)
  @@unique([accountId, symbol, exDate])
}

/// 사용자가 지운 자동 배당: 다시 만들지 않는다
model DividendSkip {
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol    String
  exDate    DateTime @db.Date

  @@id([accountId, symbol, exDate])
}

/// 종목별 배당 이력 캐시 (배당락일, 주당 배당금 — 현지 통화, 지금 주식 수 기준)
model DividendEvent {
  symbol String
  exDate DateTime @db.Date
  amount Decimal  @db.Decimal(20, 6)

  @@id([symbol, exDate])
}

enum CashType {
  DEPOSIT
  WITHDRAW
  EXCHANGE
}

enum Currency {
  KRW
  USD
}

/// 현금 입출금·환전. 환전은 currency(보낸 통화)의 amount를 fxRate(원/USD)로 바꾼다.
model CashFlow {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      CashType
  currency  Currency
  amount    Decimal  @db.Decimal(20, 4)
  /// 환전·달러 입출금의 환율 (1 USD 당 KRW). 원화 입출금은 1.
  fxRate    Decimal  @default(1) @db.Decimal(20, 4)
  date      DateTime @db.Date
  memo      String?
  createdAt DateTime @default(now())

  @@index([accountId, date])
}

/// 일별 종가 캐시 (환율 KRW=X 포함)
model PriceBar {
  symbol String
  date   DateTime @db.Date
  close  Decimal  @db.Decimal(20, 4)

  @@id([symbol, date])
}

/// 심볼별 시세 캐시 상태
model SymbolCache {
  symbol         String    @id
  price          Decimal?  @db.Decimal(20, 4)
  previousClose  Decimal?  @db.Decimal(20, 4)
  currency       String?
  quoteFetchedAt DateTime?
  barsFetchedAt  DateTime?
  /// 배당 이력을 받아 온 시각
  divFetchedAt   DateTime?
  /// 국내 종목의 증권사 표기 한글 이름 (네이버 증권 기준)
  name           String?
  nameFetchedAt  DateTime?
}
