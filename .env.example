# PostgreSQL 연결 문자열 (Neon, Supabase, Vercel Postgres 등 무료 플랜 가능)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/donjo"

# (선택) 커넥션 풀링 주소. 서버리스(Vercel)에서 DB 동시 접속 한도 초과를 막는다.
# ACCELERATE_URL → PRISMA_DATABASE_URL → DATABASE_URL → POSTGRES_URL 순으로 찾아서,
# Accelerate 주소(prisma+postgres://) 또는 풀러 주소(호스트가 pooled.* , 예: pooled.db.prisma.io)가 있으면 앱 쿼리에 쓴다.
# 풀러 주소에는 pgbouncer=true가 자동으로 붙는다. 마이그레이션은 위 DATABASE_URL(직접 연결)을 쓴다.
# ACCELERATE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# 세션 암호화 키: `npx auth secret` 또는 `openssl rand -base64 32` 로 생성
AUTH_SECRET=""

# 시세 데이터 공급자: yahoo(기본, 무료·키 불필요) | mock(개발용 가짜 시세)
MARKET_DATA_PROVIDER="yahoo"
